# Kopieren nach .env und eintragen (wird von gitignored; NIE committen!)
# Starker Zufallswert z.B. via: openssl rand -hex 32

MCP_HTTP_PORT=8030
DASHBOARD_PORT=8501

# Optionaler OpenAPI-Endpoint (mcpo) auf :8031
ENABLE_MCPO=false
MCPO_PORT=8031
# API-Key fuer den mcpo-OpenAPI-Endpoint (leer = keine Auth)
MCP_API_KEY=

# Collector-Daemon (fuellt Qdrant im Hintergrund)
ENABLE_COLLECTOR=false

# Nur mit Profil "vector" + QDRANT_URL=http://world-intel-qdrant:6333
QDRANT_URL=

TZ=Europe/Berlin
